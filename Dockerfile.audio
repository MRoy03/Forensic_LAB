# Standalone audio + Organika service -- see DEPLOYMENT.md's "split
# services" option. Originally audio-only; Organika/sdxl-detector (the
# other large model, ~91.6MB quantized) was added here too once both were
# confirmed to fit comfortably together (measured: ~540MB combined on the
# Oracle Always Free VM this actually runs on, well under its ~952MB RAM).
# Isolating both out of the "core" deployment keeps that one's RAM budget
# to the primary model + detectra-v1 + RAG, uncontested.
#
# No Streamlit here -- that stays in the "core" deployment (built from the
# root Dockerfile with ENABLE_AUDIO=false / ENABLE_ORGANIKA=false set as
# env vars there). This image just runs uvicorn directly with
# ENABLE_CORE=false / ENABLE_AUDIO=true / ENABLE_ORGANIKA=true, so
# app/main.py registers /health, /predict/audio, and /predict/organika --
# not /predict/image, /predict/video, /playground, or /feedback.
#
# Reuses the full requirements.txt rather than a trimmed one: the routers
# in app/routes.py are all imported at module level regardless of which
# ones get registered, so opencv etc. still need to be installed even
# though video/image routes are never reachable from this image. Costs a
# bit of extra build size, not runtime RAM (model files, not libraries,
# are what's actually large).

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV ENABLE_CORE=false
ENV ENABLE_AUDIO=true
ENV ENABLE_ORGANIKA=true
ENV PYTHONUNBUFFERED=1

EXPOSE 7860

CMD uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-7860}
