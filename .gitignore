__pycache__/
*.pyc
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/
.export_venv/

# Trained weights (large binaries, not committed)
models/*.pth
models/*.onnx
models/*.onnx.data
models/**/*.onnx
models/**/*.onnx_data
models/**/*.onnx.data
models/**/*.safetensors
!models/.gitkeep
!models/**/.gitkeep

# Data (large / user-specific)
data/images/*
data/masks/*
data/synthetic_data/*
data/feedback_data/images/*
!data/images/.gitkeep
!data/masks/.gitkeep
!data/synthetic_data/.gitkeep
!data/feedback_data/.gitkeep
!data/feedback_data/images/.gitkeep
data/feedback_data/feedback_log.csv

.DS_Store
Thumbs.db
*.log

# SSH keys (never commit -- e.g. Oracle Cloud's downloaded instance key pair).
# *.pub as its own broad pattern, not just *.key.pub: OCI's browser download
# can rename a duplicate to e.g. "ssh-key-2026-11-21.key (2).pub", which the
# narrower suffix-only pattern would miss.
*.pem
*.key
*.pub
